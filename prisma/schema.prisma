generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CandidateStage {
  NEW
  SOURCED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum CandidateSource {
  INTERNAL
  LINKEDIN
  EMAIL
  JOB_BOARD
  REFERRAL
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  candidates    Candidate[]
  conversations Conversation[]
  events        Event[]
}

model Account {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  role           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Candidate {
  id             String          @id @default(cuid())
  organizationId String
  fullName       String
  title          String?
  location       String?
  email          String?
  phone          String?
  linkedinUrl    String?
  source         CandidateSource @default(INTERNAL)
  stage          CandidateStage  @default(NEW)
  tags           Json?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  events        Event[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, source])
  @@index([fullName])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String?
  subject        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate     Candidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([organizationId])
  @@index([candidateId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection @default(OUTBOUND)
  body           String
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Event {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String?
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate     Candidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([candidateId])
}

